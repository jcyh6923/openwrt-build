# =========================================================
#             ⚙️ OpenWrt X86 专属定制编译配置单
#       (插件集与 ARM nowifi-ress01 完全一致版)
# =========================================================

# --- 内核开发者选项 (BPF/BTF 必须开启) ---
CONFIG_DEVEL=y

# ---------------------------------------------------------
# 1. 核心架构与系统平台 (X86_64)
# ---------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------------------------------------------------------
# 2. 固件镜像与分区设置 (完美适配 PVE 虚拟机)
# ---------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---------------------------------------------------------
# 2.1 默认管理地址
# ---------------------------------------------------------
CONFIG_TARGET_PREINIT_IP="192.168.2.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.2.255"

# ---------------------------------------------------------
# 3. 内核 eBPF 与 BTF 支持 (nft-tproxy / sing-box 必须)
# ---------------------------------------------------------
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_PACKAGE_kmod-btf=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n

# ---------------------------------------------------------
# 4. 核心防火墙与底层网络组件
# ---------------------------------------------------------
# 强制开启 fw4 (nftables)，剔除老版 fw3 和 wireguard
CONFIG_PACKAGE_firewall=n
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_ip-full=y

# 明确拒绝 rclone 及其附加面板，防止官方默认强塞
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_rclone=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui=n
CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng=n

# ---------------------------------------------------------
# 5. 系统实用工具
# ---------------------------------------------------------
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_qemu-ga=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ---------------------------------------------------------
# 6. 核心科学、网络代理与所有插件 (与 ARM nowifi-ress01 一致)
# ---------------------------------------------------------
# -- 禁用 SSR Plus (已移除) --
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn is not set

# -- Passwall 主体 --
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_GO=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Tuic_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn is not set

# -- Passwall 核心二进制依赖 --
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_trojan-go=y
CONFIG_PACKAGE_haproxy=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_simple-obfs=y
CONFIG_PACKAGE_v2ray-plugin=y
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=y
CONFIG_PACKAGE_shadowsocks-libev-ss-server=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocks-rust-ssserver=y

# -- Passwall DNS 依赖 --
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_pdnsd-alt=y

# -- Passwall 透明代理内核模块 (fw4/nftables 模式) --
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ipset=y

# -- 其他保留代理工具 --
#CONFIG_PACKAGE_luci-app-homeproxy=y
#CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_mihomo=n
CONFIG_PACKAGE_mihomo-alpha=n
CONFIG_PACKAGE_mihomo-meta=n
#CONFIG_PACKAGE_luci-app-nikki=y
#CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
#CONFIG_PACKAGE_luci-app-dae=y
#CONFIG_PACKAGE_luci-i18n-dae-zh-cn=y
#CONFIG_PACKAGE_dae=y

# -- 地图规则库 --
CONFIG_PACKAGE_v2ray-geoip=n
CONFIG_PACKAGE_v2ray-geosite=n
CONFIG_PACKAGE_v2ray-geodata=n
CONFIG_PACKAGE_v2ray-geodata-updater=n

# -- 局域网与其他实用插件 --
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=n
#CONFIG_PACKAGE_luci-app-vlmcsd=n
#CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=n
CONFIG_PACKAGE_luci-app-cpufreq=n
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=n
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-xupnpd=y
CONFIG_PACKAGE_luci-i18n-xupnpd-zh-cn=y
CONFIG_PACKAGE_xupnpd=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# ---------------------------------------------------------
# 7. 语言包与多主题合集
# ---------------------------------------------------------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# -- argon 主题 --
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# -- Kucat 主题 --
#CONFIG_PACKAGE_luci-theme-kucat=y
#CONFIG_PACKAGE_luci-app-kucat-config=y
#CONFIG_PACKAGE_luci-i18n-kucat-config-zh-cn=y

# --- 手机 App 远程控制端依赖 ---
CONFIG_PACKAGE_luci-mod-rpc=n
CONFIG_PACKAGE_luci-compat=n
